{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "CMake Configure",
			"type": "shell",
			"command": "cmake",
			"args": ["--preset", "Debug"],
			"options": {
				"cwd": "${workspaceFolder}"
			},
			"group": "build",
			"problemMatcher": []
		},
		{
			"label": "Build",
			"type": "shell",
			"command": "D:/030/ninja.exe",
			"args": [],
			"options": {
				"cwd": "${workspaceFolder}/build/Debug"
			},
			"group": {
				"kind": "build",
				"isDefault": true
			},
			"problemMatcher": "$gcc",
			"dependsOn": []
		},
		{
			"label": "Flash",
			"type": "shell",
			"command": "openocd",
			"args": [
				"-f", "interface/stlink.cfg",
				"-f", "target/stm32f1x.cfg",
				"-c", "program usart.elf verify reset exit"
			],
			"options": {
				"cwd": "${workspaceFolder}/build/Debug"
			},
			"group": "build",
			"problemMatcher": [],
			"dependsOn": ["Build"]
		},
		{
			"label": "Build and Flash",
			"type": "shell",
			"command": "openocd",
			"args": [
				"-f", "interface/stlink.cfg",
				"-f", "target/stm32f1x.cfg",
				"-c", "program usart.elf verify reset exit"
			],
			"options": {
				"cwd": "${workspaceFolder}/build/Debug"
			},
			"group": "build",
			"problemMatcher": [],
			"dependsOn": ["Build"]
		}
	]
}